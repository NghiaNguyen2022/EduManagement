# Sao chép thành .env.local tại thư mục gốc dự án trên VPS.
# Không commit file .env.local và không dùng nguyên các giá trị CHANGE_ME.

NODE_ENV="production"
HOST="127.0.0.1"
PORT="3100"

DATABASE_HOST="127.0.0.1"
DATABASE_PORT="3306"
DATABASE_USER="edu_management_app"
DATABASE_PASSWORD="CHANGE_ME_STRONG_DATABASE_PASSWORD"
DATABASE_NAME="edu_management"
DATABASE_CONNECTION_LIMIT="10"

AUTH_COOKIE_NAME="edu_management_session"
COOKIE_PATH="/app-portal/edu-management"

# Biến Vite được đóng vào frontend tại thời điểm build.
VITE_APP_TITLE="Quản lý Trường học"
VITE_APP_BASE_PATH="/app-portal/edu-management/"
