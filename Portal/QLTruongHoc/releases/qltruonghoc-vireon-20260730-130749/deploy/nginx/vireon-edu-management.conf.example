# Chèn hai khối location này vào server { ... } HTTPS hiện có của vireon.vn.
# Không tạo server_name thứ hai và không thay đổi website đang chạy tại /.

location = /app-portal/edu-management {
    return 301 /app-portal/edu-management/;
}

location ^~ /app-portal/edu-management/ {
    # Dấu "/" cuối proxy_pass là bắt buộc: Nginx sẽ bỏ tiền tố
    # /app-portal/edu-management/ trước khi chuyển yêu cầu vào Node.js.
    proxy_pass http://127.0.0.1:3100/;
    proxy_http_version 1.1;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    client_max_body_size 6m;
    proxy_connect_timeout 10s;
    proxy_read_timeout 120s;
}
